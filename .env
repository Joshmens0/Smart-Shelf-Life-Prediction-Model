# ══════════════════════════════════════════════════════════════════
# Smart Shelf Life Prediction Model — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Mode & Application Settings
DEV_MODE=false
REQUIRE_AUTH=false
SECRET_KEY=dev-secret-key-change-in-production-smart-shelf
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding (0.0.0.0 is required for Docker / Nginx reverse proxy)
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For Docker Compose (PostgreSQL container):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shelflife
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/shelflife
# For Local Non-Docker Development (uncomment below):
# DATABASE_URL=sqlite+aiosqlite:///webapp/backend/dev.db

# Redis Cache & Lock
REDIS_URL=redis://redis:6379/0

# Model Artifact Locations (Relative to project root or container root)
MODEL_CHECKPOINT_PATH=model/checkpoints/best_model.pt
MODEL_CONFIG_PATH=model/config.yaml

# File Storage
UPLOAD_DIR=/app/webapp/backend/tmp/uploads

# Domain & SSL (for VPS setup script)
DOMAIN_NAME=localhost
CERTBOT_EMAIL=admin@example.com
