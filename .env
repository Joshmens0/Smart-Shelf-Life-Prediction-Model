# ══════════════════════════════════════════════════════════════════
# Smart Shelf Life Prediction Model — Local Environment Config
# ══════════════════════════════════════════════════════════════════

# Mode & Application Settings
DEV_MODE=true
REQUIRE_AUTH=false
SECRET_KEY=dev-secret-key-change-in-production-smart-shelf
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=127.0.0.1
PORT=8000

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///webapp/backend/dev.db

# Model Artifact Locations (Relative to project root)
MODEL_CHECKPOINT_PATH=model/checkpoints/best_model.pt
MODEL_CONFIG_PATH=model/config.yaml

# File Storage
UPLOAD_DIR=webapp/backend/tmp/uploads
