# ══════════════════════════════════════════════════════════════════
# Smart Shelf Life Prediction Model — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Mode & Application Settings
DEV_MODE=false
REQUIRE_AUTH=true
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL in Production)
POSTGRES_USER=shelfuser
POSTGRES_PASSWORD=choose_a_strong_password_here
POSTGRES_DB=shelflife
DATABASE_URL=postgresql+asyncpg://shelfuser:choose_a_strong_password_here@db:5432/shelflife

# Redis Cache & Lock
REDIS_URL=redis://redis:6379/0

# Model Artifact Locations (Relative to project root or container root)
MODEL_CHECKPOINT_PATH=model/checkpoints/best_model.pt
MODEL_CONFIG_PATH=model/config.yaml

# File Storage
UPLOAD_DIR=/app/webapp/backend/tmp/uploads

# Domain & SSL (for VPS setup script)
DOMAIN_NAME=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
