# Git
.git
.gitignore

# Virtual Environments & Python Cache (prevent multi-GB copies and symlink failures)
.venv
**/.venv
**/.venv/**
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.coverage
htmlcov

# Node & Frontend Build Cache
node_modules
**/node_modules
**/node_modules/**
webapp/frontend/node_modules
webapp/frontend/dist
webapp/frontend/.vite

# Large Training Raw Datasets (Only model/checkpoints/ is needed)
model/data
model/data/**
model/preprocessed_data.csv

# Temporary Uploads and Local Database
webapp/backend/tmp/uploads/*
!webapp/backend/tmp/uploads/.gitkeep
webapp/backend/dev.db
*.db
*.sqlite3

# Environment Files with Secrets
.env
webapp/backend/.env

# OS / Editor Files
.DS_Store
Thumbs.db
.idea
.vscode
